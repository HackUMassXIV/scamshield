# Copy to .env and fill in.   cp .env.example .env
# Everything here is read by edge/config.py (and later cloud/).

# ---------------------------------------------------------------- tunnel / URLs
# The public HTTPS URL of your laptop tunnel (cloudflared / ngrok). Twilio signs
# webhooks against THIS URL, and it builds the wss:// media-stream URL from it.
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# ---------------------------------------------------------------------- Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_NUMBER=+1413XXXXXXX            # the "Guardian" number students merge in
TWILIO_VALIDATE_SIGNATURE=1           # keep 1 except when curl-testing locally
TWILIO_DRY_RUN=0                      # 1 = log TwiML updates instead of calling Twilio
# TWILIO_SAY_VOICE=Polly.Joanna       # optional <Say> voice
# DISCLOSURE_TEXT=This call is being screened by an automated scam filter. No audio is saved.
LEG_TIMEOUT_SEC=300                   # hang up if the student never presses Start

# ------------------------------------------------------------------ app access
GUARDIAN_API_KEY=change-me-long-random   # PWA sends X-Guardian-Key; ws uses ?key=
ALLOWED_ORIGINS=*                         # lock to your PWA origin before judging
# DEMO_FALLBACK_USER=alex                 # map unknown callers to a demo user (demo only!)

# ------------------------------------------------------------------- speech
ASR_BACKEND=faster-whisper            # or "fake" for tests
WHISPER_MODEL=base.en                 # tiny.en if your CPU is slow, small.en on a GPU
WHISPER_DEVICE=auto                   # auto | cpu | cuda
WHISPER_COMPUTE=auto                  # auto -> int8 on CPU, float16 on CUDA
VAD_BACKEND=auto                      # auto | silero | energy
SILENCE_MS=400
MAX_UTT_SEC=6
LOG_TRANSCRIPTS=1                     # logs REDACTED text only

# ------------------------------------------------- classifier + risk (sections 7-8)
CLF_BACKEND=auto                      # auto: models/clf (DistilBERT) > models/clf_tfidf.joblib > keywords
FLAG_SECONDS=600                      # "I'm suspicious" keeps the color >= YELLOW this long

# -------------------------------------------------------------- cloud (section 8)
CLOUD_URL=http://localhost:9000       # where the edge sends redacted RiskEvents (Vultr later)
CLOUD_API_KEY=change-me-cloud-key     # shared by edge and cloud (X-Cloud-Key)
BANK_BACKEND=fake                     # fake (in-memory demo bank) | nessie (after cloud.seed_nessie)
COOLDOWN_SEC=600                      # held payment release cool-down (60 for the demo)
NESSIE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash         # check ai.google.dev for the current flash model name
MONGODB_URI=                          # mongodb+srv://... from Atlas; empty = in-memory store
ELEVENLABS_API_KEY=                   # only for making a CONSENTED voice clone test clip

# ------------------------------------------------------ local LLM verdict (section 11)
LLM_BACKEND=ollama                    # ollama | off   (python run.py llm pulls + warms it)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b               # qwen2.5:1.5b on a slow CPU
LLM_MIN_INTERVAL=15                   # at most one verdict per call every N seconds

# --------------------------------------------------------- coaching alerts (section 10)
ALERT_CHANNEL=sms                     # sms | whatsapp | off  (uses TWILIO_NUMBER)
WHATSAPP_FROM=                        # e.g. whatsapp:+14155238886 (Twilio WhatsApp sandbox)
ALERT_COOLDOWN_SEC=20
TRUSTED_COOLDOWN_SEC=600

# ------------------------------------------------------------- app + push (section 9)
VAPID_PUBLIC_KEY=                     # python -m cloud.push  prints a pair (needs pywebpush)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
DOMAIN=                               # Vultr: your GoDaddy domain, for deploy/Caddyfile
